# Crime Kickers Hub Environment Variables
# Copy this file to .env and fill in your values

# Database (uses default: data/crime-kickers.db)
DB_PATH=data/crime-kickers.db

# Server
SERVER_ADDR=:8080

# Frontend path for static file serving (uses default: frontend/dist)
FRONTEND_PATH=frontend/dist

# Google OAuth2 (leave empty for development without auth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback
ADMIN_EMAILS=your-email@example.com
COOKIE_SECRET=dev-secret-key-change-in-production

# Cloudflare R2 Storage (required for image uploads)
# Get these from: https://dash.cloudflare.com/ -> R2 -> Overview
# 1. Create a bucket
# 2. Create an API token with R2 permissions
# 3. Set up a custom domain for public access (or use r2.dev subdomain)
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_DOMAIN=https://your-bucket.r2.dev
# Note: Must include https:// protocol in the domain

# Telegram notifications (optional)
TG_BOT_TOKEN=
TG_CHAT_ID=
