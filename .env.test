# Test environment variables for Crime Kickers Hub

# Database
DB_PATH=data/test-crime-kickers.db

# Server
SERVER_ADDR=:8080

# Frontend
FRONTEND_PATH=frontend/dist

# Google OAuth (placeholder - not functional without real credentials)
GOOGLE_CLIENT_ID=test-client-id
GOOGLE_CLIENT_SECRET=test-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8080/api/auth/google/callback

# Admin whitelist (for testing)
ADMIN_EMAILS=admin@test.com,test@example.com

# Cookie secret (for session management)
COOKIE_SECRET=test-secret-key-change-in-production

# R2 / Cloudflare (optional - can be empty for local testing)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=
